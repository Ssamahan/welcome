--- /dev/null
+++ b/scripts/credentials.mjs
@@ -0,0 +1,36 @@
+#!/usr/bin/env node
+/**
+ * Generate the values the server requires, so neither ever has to be written
+ * down in a document or a repository.
+ *
+ *   npm run hash -- "your long password"     # prints ADMIN_PASSWORD_HASH=…
+ *   npm run secret                            # prints JWT_SECRET=…
+ */
+import crypto from 'node:crypto';
+import bcrypt from 'bcryptjs';
+
+const [, , cmd, ...rest] = process.argv;
+
+if (cmd === 'secret') {
+  console.log(`JWT_SECRET=${crypto.randomBytes(48).toString('base64')}`);
+  process.exit(0);
+}
+
+if (cmd === 'hash') {
+  const password = rest.join(' ');
+  if (!password) {
+    console.error('Usage: npm run hash -- "your long password"');
+    process.exit(1);
+  }
+  if (password.length < 12) {
+    console.error('Refusing: choose a password of at least 12 characters.');
+    process.exit(1);
+  }
+  const hash = bcrypt.hashSync(password, 12);
+  console.log(`ADMIN_PASSWORD_HASH=${hash}`);
+  console.log('\nKeep this hash in the host dashboard only. To change the password, run this again and replace the value.');
+  process.exit(0);
+}
+
+console.error('Usage: npm run hash -- "password"   |   npm run secret');
+process.exit(1);

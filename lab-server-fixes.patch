+/**
+ * The HTTP application, as a factory.
+ *
+ * Everything that touches the outside world — the database pool and the mail
+ * transport — is passed in, so the routes can be exercised with stubs and the
+ * entry point (`server.js`) keeps all the environment reading and startup
+ * validation. This split is what makes `npm test` possible without a database.
+ */
+import express from 'express';
+import cors from 'cors';
+import helmet from 'helmet';
+import jwt from 'jsonwebtoken';
+import bcrypt from 'bcryptjs';
+import rateLimit from 'express-rate-limit';
+
+export function escHtml(s) {
+  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
+    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
+  ));
+}
+
+/**
+ * @param {object} deps
+ * @param {{query:Function, connect:Function}} deps.pool  Postgres pool
+ * @param {object} deps.config  see server.js for the shape
+ * @param {Function|null} [deps.sendMail]  injected mailer (tests)
+ */
+export function createApp({ pool, config, sendMail = null }) {
+  const {
+    jwtSecret, adminUsername, adminPasswordHash, allowedOrigins,
+    emailFrom = '', emailConfigured = false, getTransporter = () => null,
+  } = config;
+
+  const dbGet = async (key) => {
+    const res = await pool.query('SELECT value, updated_at, updated_by FROM kv WHERE key=$1', [key]);
+    return res.rows[0] || null;
+  };
+
+  const dbSet = async (key, value, updated_at, updated_by) => {
+    const client = await pool.connect();
+    try {
+      await client.query('BEGIN');
+      await client.query(
+        `INSERT INTO kv (key, value, updated_at, updated_by) VALUES ($1,$2,$3,$4)
+         ON CONFLICT(key) DO UPDATE SET value=EXCLUDED.value, updated_at=EXCLUDED.updated_at, updated_by=EXCLUDED.updated_by`,
+        [key, value, updated_at, updated_by],
+      );
+      await client.query('INSERT INTO history (key, value, updated_at, updated_by) VALUES ($1,$2,$3,$4)', [
+        key, value, updated_at, updated_by,
+      ]);
+      await client.query('COMMIT');
+    } catch (e) {
+      await client.query('ROLLBACK').catch(() => {});
+      throw e;
+    } finally {
+      client.release();
+    }
+  };
+
+  const dbCount = async () => {
+    const r = await pool.query('SELECT COUNT(*)::int AS c FROM kv');
+    return r.rows[0].c;
+  };
+
+  const app = express();
+  app.disable('x-powered-by');
+  app.set('trust proxy', 1);
+
+  app.use(helmet({ crossOriginResourcePolicy: false }));
+  app.use(express.json({ limit: '15mb' }));
+
+  /* An explicit allowlist. `origin: true` reflected whatever Origin the caller
+     sent and combined it with credentials, so any page could read the register. */
+  app.use(cors({
+    origin(origin, cb) {
+      if (!origin) return cb(null, true);            /* curl, native app, same-origin */
+      if (allowedOrigins.includes(origin)) return cb(null, true);
+      return cb(new Error('Origin not allowed'));
+    },
+    credentials: true,
+    methods: ['GET', 'PUT', 'POST', 'OPTIONS'],
+  }));
+
+  app.use('/api/', rateLimit({
+    windowMs: 15 * 60 * 1000, max: 200, standardHeaders: true, legacyHeaders: false,
+  }));
+  const loginLimiter = rateLimit({
+    windowMs: 15 * 60 * 1000, max: 20, standardHeaders: true, legacyHeaders: false,
+  });
+
+  const authRequired = (req, res, next) => {
+    const header = req.headers.authorization || '';
+    const token = header.startsWith('Bearer ') ? header.slice(7) : null;
+    if (!token) return res.status(401).json({ error: 'Missing token' });
+    try {
+      req.user = jwt.verify(token, jwtSecret, { algorithms: ['HS256'] });
+      return next();
+    } catch (e) {
+      return res.status(401).json({ error: 'Invalid token' });
+    }
+  };
+
+  app.get('/', (req, res) => res.json({
+    name: 'Ruli Lab Server', version: '2.0.0', status: 'online',
+    ready: true, emailConfigured, time: new Date().toISOString(),
+  }));
+
+  app.get('/api/health', async (req, res) => {
+    try {
+      const count = await dbCount();
+      res.json({ ok: true, ready: true, dbType: 'postgres', keys: count, persistent: true, emailConfigured, time: Date.now() });
+    } catch (e) {
+      res.status(503).json({ ok: false, ready: false, dbType: 'postgres', error: e.message });
+    }
+  });
+
+  app.post('/api/login', loginLimiter, async (req, res) => {
+    const { username, password } = req.body || {};
+    if (!username || !password) return res.status(400).json({ error: 'required' });
+    if (String(username) !== adminUsername) return res.status(401).json({ error: 'Invalid' });
+    /* Async on purpose: the sync form blocked the event loop for the whole cost
+       factor, which is a trivial denial of service on a single core. */
+    const ok = await bcrypt.compare(String(password), adminPasswordHash);
+    if (!ok) return res.status(401).json({ error: 'Invalid' });
+    const token = jwt.sign({ username, role: 'admin' }, jwtSecret, { expiresIn: '30d', algorithm: 'HS256' });
+    return res.json({ token, username, expiresIn: '30d' });
+  });
+
+  /* This route used to have no `authRequired`, so the whole register — the staff
+     roster and referred samples included — was readable by anyone with the URL. */
+  app.get('/api/data', authRequired, async (req, res, next) => {
+    try {
+      const key = String(req.query.key || 'lab/v1');
+      const row = await dbGet(key);
+      if (!row) return res.json({ data: null, at: null, by: null, key });
+      try {
+        const parsed = JSON.parse(row.value);
+        return res.json({ data: parsed.data || parsed, at: row.updated_at, by: row.updated_by, key, raw: parsed });
+      } catch (e) {
+        return res.json({ data: null, at: row.updated_at, by: row.updated_by, key });
+      }
+    } catch (e) { return next(e); }
+  });
+
+  app.put('/api/data', authRequired, async (req, res, next) => {
+    try {
+      const key = String(req.query.key || 'lab/v1');
+      const { data } = req.body || {};
+      if (!data) return res.status(400).json({ error: 'data required' });
+      const now = Date.now();
+      const payload = JSON.stringify({ data, at: now, by: req.user.username });
+      await dbSet(key, payload, now, req.user.username);
+      return res.json({ ok: true, key, at: now, by: req.user.username, dbType: 'postgres' });
+    } catch (e) { return next(e); }
+  });
+
+  const mailer = () => (sendMail ? { sendMail } : getTransporter());
+
+  app.post('/api/send-otp', authRequired, async (req, res) => {
+    const { toEmail, otp, purpose } = req.body || {};
+    if (!toEmail || !otp) return res.status(400).json({ error: 'toEmail and otp required' });
+    const transporter = mailer();
+    if (!transporter) return res.status(500).json({ error: 'Email not configured - set EMAIL_USER and EMAIL_PASS in the host environment' });
+    const safeOtp = escHtml(otp);
+    const safePurpose = escHtml(purpose || 'login');
+    const subject = `Ruli Lab Systems — OTP ${String(otp).slice(0, 12)} for ${String(purpose || 'login').slice(0, 40)}`;
+    const html = `<div style="font-family:Trebuchet MS,sans-serif;max-width:600px;margin:0 auto;border:1px solid #e6e9f1;border-radius:12px;overflow:hidden"><div style="background:#0B1C3D;color:white;padding:20px;text-align:center"><h2 style="margin:0;color:#C9A84C">Ruli District Hospital</h2><div>Laboratory Department — Lab Systems</div></div><div style="padding:24px"><h3 style="color:#0B1C3D">Your OTP Code</h3><p>Your OTP for <b>${safePurpose}</b> is:</p><div style="font-size:32px;font-weight:900;letter-spacing:6px;text-align:center;background:#F7F8FC;border:2px dashed #C9A84C;border-radius:10px;padding:16px;margin:16px 0;color:#0B1C3D">${safeOtp}</div><p><b>Valid 5 minutes.</b></p><p style="color:#64748B;font-size:13px">Time: ${new Date().toISOString()}</p></div></div>`;
+    try {
+      const info = await transporter.sendMail({
+        from: emailFrom, to: toEmail, subject, html,
+        text: `OTP ${otp} for ${purpose || 'login'} - valid 5 min`,
+      });
+      return res.json({ ok: true, messageId: info && info.messageId, to: toEmail });
+    } catch (e) {
+      console.error('OTP send failed:', e.message);
+      return res.status(502).json({ error: 'Email send failed' });
+    }
+  });
+
+  app.post('/api/send-alert', authRequired, async (req, res) => {
+    const { toEmail, subject, html, text } = req.body || {};
+    if (!toEmail) return res.status(400).json({ error: 'toEmail required' });
+    const transporter = mailer();
+    if (!transporter) return res.status(500).json({ error: 'Email not configured - set EMAIL_USER and EMAIL_PASS in the host environment' });
+    const finalSubject = String(subject || `Ruli Lab — Alert — ${new Date().toISOString().slice(0, 10)}`).slice(0, 160);
+    const finalHtml = html || `<div style="font-family:Trebuchet MS,sans-serif;padding:20px"><h3 style="color:#0B1C3D">Ruli Lab Alert</h3><p>${escHtml(text || 'Alert')}</p><p style="color:#64748B">Time: ${new Date().toISOString()}</p></div>`;
+    try {
+      const info = await transporter.sendMail({ from: emailFrom, to: toEmail, subject: finalSubject, html: finalHtml, text: text || finalSubject });
+      return res.json({ ok: true, messageId: info && info.messageId, to: toEmail });
+    } catch (e) {
+      console.error('Alert send failed:', e.message);
+      return res.status(502).json({ error: 'Email send failed' });
+    }
+  });
+
+  /* JSON errors, so a rejected origin or a thrown route never returns a stack trace. */
+  app.use((err, req, res, next) => {   // eslint-disable-line no-unused-vars
+    if (res.headersSent) return next(err);
+    if (err && err.message === 'Origin not allowed') {
+      return res.status(403).json({ error: 'Origin not allowed' });
+    }
+    /* body-parser and friends attach a 4xx status to client errors (malformed
+       JSON, payload too large). Honour it instead of reporting 500, which would
+       both mislead the caller and look like a server fault in the logs. */
+    const status = Number(err && (err.status || err.statusCode));
+    if (Number.isInteger(status) && status >= 400 && status < 500) {
+      return res.status(status).json({ error: status === 413 ? 'Payload too large' : 'Bad request' });
+    }
+    console.error('Unhandled route error:', err && err.message);
+    return res.status(500).json({ error: 'Internal error' });
+  });
+
+  return app;
+}

+/* ── Stubs ────────────────────────────────────────────────────────────────── */
+const kv = new Map();
+const history = [];
+const pool = {
+  async query(sql, params = []) {
+    const q = String(sql);
+    if (/SELECT COUNT\(\*\)/.test(q)) return { rows: [{ c: kv.size }] };
+    if (/SELECT value, updated_at, updated_by FROM kv WHERE key=\$1/.test(q)) {
+      const row = kv.get(params[0]);
+      return { rows: row ? [row] : [] };
+    }
+    if (/INSERT INTO kv/.test(q)) {
+      kv.set(params[0], { value: params[1], updated_at: params[2], updated_by: params[3] });
+      return { rows: [] };
+    }
+    if (/INSERT INTO history/.test(q)) { history.push({ key: params[0] }); return { rows: [] }; }
+    return { rows: [] };
+  },
+  async connect() {
+    return { query: (s, p) => pool.query(s, p), release() {} };
+  },
+};
+
+const sent = [];
